# Root compose environment. Copy to .env and set real values.
# NEVER commit the real .env. This file documents every variable.

# --- PostgreSQL ---
POSTGRES_DB=crm
POSTGRES_USER=crm
# Required: choose a strong password.
POSTGRES_PASSWORD=change-me-strong-password

# --- Django ---
# Required in production: a long, random, unique value (50+ chars).
DJANGO_SECRET_KEY=change-me-to-a-long-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:8080
CSRF_TRUSTED_ORIGINS=http://localhost:8080
# Keep False for plain-HTTP local runs; leave default (True) behind TLS.
SECURE_SSL_REDIRECT=False
GUNICORN_WORKERS=3

# --- AI command feature (optional) ---
# Leave AI_COMMANDS_ENABLED=False, or set a key to enable AI commands.
AI_COMMANDS_ENABLED=True
ANTHROPIC_API_KEY=

# --- Frontend ---
FRONTEND_PORT=8080
