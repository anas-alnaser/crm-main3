# Copy to .env for local development. Do not commit the real .env.

# Core
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:5175,http://127.0.0.1:5175
# Required only when DEBUG=False and cookies/CSRF are used cross-origin.
CSRF_TRUSTED_ORIGINS=

# Database ---------------------------------------------------------------
# Preferred: a single DATABASE_URL (Supabase Session Pooler on port 5432 is
# valid for this persistent Django service). When DATABASE_URL is set it takes
# precedence over the POSTGRES_* variables below.
#   DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
# Optional separate connection preferred for migrations/backups (e.g. the direct
# connection once IPv6 is confirmed). Used when DJANGO_DB_TARGET=migration.
#   DATABASE_MIGRATION_URL=
# Supabase requires SSL; leave as 'require' unless you know otherwise.
DATABASE_SSLMODE=require
DATABASE_CONN_MAX_AGE=60
DATABASE_URL=
DATABASE_MIGRATION_URL=
# Set to 'migration' to route Django at DATABASE_MIGRATION_URL for a command run.
DJANGO_DB_TARGET=runtime

# Backward-compatible individual variables (local / Docker PostgreSQL).
# Leave POSTGRES_DB empty (and DATABASE_URL empty) for the local SQLite dev
# fallback. Production (DJANGO_DEBUG=False) requires one of these to be set —
# Django never silently falls back to SQLite in production.
POSTGRES_DB=
POSTGRES_USER=crm
POSTGRES_PASSWORD=crm
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# POSTGRES_SSLMODE=            # only if a networked instance needs SSL

# Business timezone for shift/workforce logic (day boundaries + 9AM–9PM window).
BUSINESS_TIMEZONE=Asia/Amman

# JWT lifetimes
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7
JWT_ROTATE_REFRESH=False

# API behaviour
API_PAGE_SIZE=25
THROTTLE_USER=5000/hour
THROTTLE_ANON=100/hour
THROTTLE_LOGIN=20/min
THROTTLE_AI=30/min

# Production transport security (only applied when DJANGO_DEBUG=False)
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
USE_X_FORWARDED_PROTO=True

# AI command feature (optional). Without a key the AI endpoints return 503.
AI_COMMANDS_ENABLED=True
ANTHROPIC_API_KEY=
AI_CONFIRMATION_TTL_SECONDS=300
AI_COMMAND_MAX_LENGTH=2000
AI_CONFIDENCE_THRESHOLD=0.75

# Workforce / shift tracking
WORKFORCE_INACTIVITY_MINUTES=10
WORKFORCE_HEARTBEAT_SECONDS=30
WORKFORCE_DEFAULT_START_TIME=09:00
WORKFORCE_DEFAULT_END_TIME=21:00
WORKFORCE_DEFAULT_DAILY_TARGET_MINUTES=180

# Media / uploaded assets (brand logos, signatures)
MEDIA_URL=/media/
UPLOAD_MAX_IMAGE_BYTES=5242880
UPLOAD_MAX_IMAGE_DIMENSION=4000
LEAD_IMPORT_MAX_BYTES=5242880
LEAD_IMPORT_MAX_ROWS=5000

# Logging
LOG_LEVEL=INFO
