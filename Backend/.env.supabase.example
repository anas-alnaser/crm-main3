# Supabase development connection — EXAMPLE ONLY (no secrets).
#
# Copy this to `.env.supabase.local` (which is git-ignored) and paste your real
# Supabase Session Pooler URI. NEVER commit the real file, print its contents,
# or send it to the frontend.
#
# Then validate the connection safely WITHOUT touching Django's default DB:
#   python manage.py check_supabase --health-check
#
# To run migrations against Supabase through Django (owns the schema):
#   DJANGO_ENV_FILE=.env.supabase.local python manage.py migrate --plan
#   DJANGO_ENV_FILE=.env.supabase.local python manage.py migrate
#
# Where to find these values in the Supabase dashboard:
#   Project Settings → Database → Connection string → "Session pooler" (port 5432).

# Session Pooler (port 5432) — the normal persistent Django runtime connection.
DATABASE_URL=postgresql://postgres.<project-ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Optional: Direct connection (port 5432) preferred for migrations/backups once
# IPv6 is confirmed. Do NOT use the transaction pooler (port 6543) as the
# persistent Django connection.
DATABASE_MIGRATION_URL=

# Supabase requires SSL.
DATABASE_SSLMODE=require
DATABASE_CONN_MAX_AGE=60
